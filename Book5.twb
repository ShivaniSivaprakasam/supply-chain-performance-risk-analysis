            </column>
            <column caption='Avg Margin Benchmark' datatype='real' name='[Calculation_1291420004081666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(AVG([avg_profit_ratio]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Margin Quadrant' datatype='string' name='[Calculation_1291420004159491]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([total_sales]) &gt;= [Calculation_1291420003987457] AND AVG([avg_profit_ratio]) &lt; [Calculation_1291420004081666]&#13;&#10;THEN &quot;High Sales, Low Margin (Review)&quot;&#13;&#10;ELSEIF SUM([total_sales]) &gt;= [Calculation_1291420003987457] AND AVG([avg_profit_ratio]) &gt;= [Calculation_1291420004081666]&#13;&#10;THEN &quot;High Sales, Healthy Margin&quot;&#13;&#10;ELSEIF SUM([total_sales]) &lt; [Calculation_1291420003987457] AND AVG([avg_profit_ratio]) &lt; [Calculation_1291420004081666]&#13;&#10;THEN &quot;Low Sales, Low Margin&quot;&#13;&#10;ELSE &quot;Low Sales, Healthy Margin&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
