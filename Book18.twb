    <worksheet name='Category Sales vs Profit Margin'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Which Categories Sell Well But Don&apos;t Turn a Profit?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Question_5' name='federated.1vaaqcr0yru8is1ava5ep0u471pf' />
          </datasources>
          <datasource-dependencies datasource='federated.1vaaqcr0yru8is1ava5ep0u471pf'>
            <column caption='Avg Sales Benchmark' datatype='real' name='[Calculation_1291420003987457]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(SUM([total_sales]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Avg Margin Benchmark' datatype='real' name='[Calculation_1291420004081666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(AVG([avg_profit_ratio]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Margin Quadrant' datatype='string' name='[Calculation_1291420004159491]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([total_sales]) &gt;= [Calculation_1291420003987457] AND AVG([avg_profit_ratio]) &lt; [Calculation_1291420004081666]&#13;&#10;THEN &quot;High Sales, Low Margin (Review)&quot;&#13;&#10;ELSEIF SUM([total_sales]) &gt;= [Calculation_1291420003987457] AND AVG([avg_profit_ratio]) &gt;= [Calculation_1291420004081666]&#13;&#10;THEN &quot;High Sales, Healthy Margin&quot;&#13;&#10;ELSEIF SUM([total_sales]) &lt; [Calculation_1291420003987457] AND AVG([avg_profit_ratio]) &lt; [Calculation_1291420004081666]&#13;&#10;THEN &quot;Low Sales, Low Margin&quot;&#13;&#10;ELSE &quot;Low Sales, Healthy Margin&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[category_name]' derivation='Attribute' name='[attr:category_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[department_name]' derivation='Attribute' name='[attr:department_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[avg_profit_ratio]' derivation='Avg' name='[avg:avg_profit_ratio:qk]' pivot='key' type='quantitative' />
            <column caption='Avg Profit Ratio' datatype='real' name='[avg_profit_ratio]' role='measure' type='quantitative' />
            <column caption='Category Name' datatype='string' name='[category_name]' role='dimension' type='nominal' />
            <column caption='Department Name' datatype='string' name='[department_name]' role='dimension' type='nominal' />
            <column-instance column='[category_name]' derivation='None' name='[none:category_name:nk]' pivot='key' type='nominal' />
