    <worksheet name='Fraud Rate by Region'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Which Regions Show the Highest Suspected Fraud Rate?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Question_12(Market &amp; Region)' name='federated.19r4kul0ov4tox10xwx9j0fkqmvi' />
          </datasources>
          <datasource-dependencies datasource='federated.19r4kul0ov4tox10xwx9j0fkqmvi'>
            <column caption='Fraud Rate Benchmark' datatype='real' name='[Calculation_1291420050944011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(AVG([fraud_pct]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Fraud Risk Flag' datatype='string' name='[Calculation_1291420051062796]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF AVG([fraud_pct]) &gt;= [Calculation_1291420050944011] THEN &quot;Above Average Fraud Rate&quot;&#13;&#10;ELSE &quot;Below Average Fraud Rate&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[market]' derivation='Attribute' name='[attr:market:nk]' pivot='key' type='nominal' />
            <column-instance column='[order_region]' derivation='Attribute' name='[attr:order_region:nk]' pivot='key' type='nominal' />
            <column caption='Canceled Pct' datatype='real' name='[canceled_pct]' role='measure' type='quantitative' />
            <column caption='Fraud Pct' datatype='real' name='[fraud_pct]' role='measure' type='quantitative' />
            <column caption='Market' datatype='string' name='[market]' role='dimension' type='nominal' />
            <column-instance column='[order_region]' derivation='None' name='[none:order_region:nk]' pivot='key' type='nominal' />
            <column caption='Order Region' datatype='string' name='[order_region]' role='dimension' type='nominal' />
            <column-instance column='[canceled_pct]' derivation='Sum' name='[sum:canceled_pct:qk]' pivot='key' type='quantitative' />
            <column-instance column='[fraud_pct]' derivation='Sum' name='[sum:fraud_pct:qk]' pivot='key' type='quantitative' />
            <column-instance column='[suspected_fraud_count]' derivation='Sum' name='[sum:suspected_fraud_count:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_order_items]' derivation='Sum' name='[sum:total_order_items:qk]' pivot='key' type='quantitative' />
            <column caption='Suspected Fraud Count' datatype='integer' name='[suspected_fraud_count]' role='measure' type='quantitative' />
